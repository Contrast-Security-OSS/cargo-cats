<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vulnerable packages for security testing -->
    <!-- CVE-2024-21907 - Newtonsoft.Json Improper Handling of Exceptional Conditions.
         The CVE Shield covers < 13.0.1, so 12.0.3 is used for the MONITOR demo (POST /photometa). -->
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />

    <!-- CVE-2018-1000210 - YamlDotNet RCE via unsafe deserialization. Its CVE Shield supports
         BLOCK, so it is used for the BLOCK demo (POST /importtags). -->
    <PackageReference Include="YamlDotNet" Version="5.1.0" />

    <!-- CVE-2021-26701 - System.Text.Encodings.Web Denial of Service -->
    <PackageReference Include="System.Text.Encodings.Web" Version="4.7.1" />

    <!-- CVE-2023-29331 - Microsoft.Data.SqlClient Information Disclosure -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="2.1.0" />

    <!-- CVE-2021-24112 - .NET Core Denial of Service Vulnerability -->
    <PackageReference Include="System.Drawing.Common" Version="5.0.0" />
  </ItemGroup>

</Project>
